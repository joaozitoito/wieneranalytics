{
  "name": "wiener-analytics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prepare-db.mjs && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && node scripts/prepare-db.mjs && prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "recharts": "^3.3.0",
    "next": "^16.0.0",
    "zod": "^4.1.0",
    "@prisma/client": "6.19.0",
    "react-dom": "^19.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "@types/papaparse": "^5.3.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "eslint-config-next": "^16.0.0",
    "vitest": "^3.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
